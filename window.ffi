; window.ffi
$lpfnWndProc = /address test.dll WindowProcessA
$hInstance = kernel32.dll voidptr GetModuleHandleA(i64 0) --assert=nonzero
$lpszClassName = str "mywindowclass"
$lpWindowName = str "mywindowname"
$hCursor = user32.dll voidptr LoadCursorA(voidptr 0, i64 32512)

$wc_size = /struct {
    $style_off = u32 style,
    $lpfnWndProc_off = voidptr lpfnWndProc,
    i32 cbClsExtra,
    i32 cbWndExtra,
    $hInstance_off = voidptr hInstance,
    voidptr hIcon,
    $hCursor_off = voidptr hCursor,
    $hbrBackground_off = voidptr hbrBackground,
    voidptr lpszMenuName,
    $lpszClassName_off = voidptr lpszClassName
}

$wc = msvcrt.dll voidptr malloc(u64 $wc_size) --assert=nonzero
msvcrt.dll voidptr memset(voidptr $wc, i32 0, u64 $wc_size)

/set $wc + $style_off u32 3
/set $wc + $lpfnWndProc_off voidptr $lpfnWndProc
/set $wc + $hInstance_off voidptr $hInstance
/set $wc + $hCursor_off voidptr $hCursor
/set $wc + $hbrBackground_off voidptr 6
/set $wc + $lpszClassName_off voidptr $lpszClassName

$class_atom = user32.dll u16 RegisterClassA(voidptr $wc) --assert=nonzero
$hWnd = user32.dll voidptr CreateWindowExA(u32 0, voidptr $lpszClassName, voidptr $lpWindowName,
 u32 0x00CF0000, i32 100, i32 100, i32 400, i32 200, voidptr 0, voidptr 0, voidptr $hInstance, voidptr 0) --assert=nonzero
user32.dll i32 ShowWindow(voidptr $hWnd, i32 5)

$MSG_size = /struct { voidptr hwnd, u32 message, u64 wParam, i64 lParam, u32 time, { i32 x, i32 y } pt } --quiet

$msg = msvcrt.dll voidptr malloc(u64 $MSG_size) --assert=nonzero
msvcrt.dll voidptr memset(voidptr $msg, i32 0, u64 $MSG_size)

/repeat {user32.dll i32 GetMessageA(voidptr $msg, voidptr 0, u32 0, u32 0) --assert=nonzero,
 user32.dll i32 TranslateMessage(voidptr $msg), user32.dll i64 DispatchMessageA(voidptr $msg)}

msvcrt.dll i32 printf(str "goodbye!\n")
msvcrt.dll void free(voidptr $wc)
msvcrt.dll void free(voidptr $msg)
/quit
