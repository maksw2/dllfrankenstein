; window_w.ffi
$lpfnWndProc = /address test.dll WindowProcessW
$hInstance = kernel32.dll voidptr GetModuleHandleA(i64 0) --print-result --assert=nonzero
$lpszClassName = wstr "mywindowclass"
$lpWindowName = wstr "mywindowname"
$hCursor = user32.dll voidptr LoadCursorW(voidptr 0, i64 32512)

$wc_size = /struct { $style_off = u32 style, $lpfnWndProc_off = voidptr lpfnWndProc, ^
 i32 cbClsExtra, i32 cbWndExtra, $hInstance_off = voidptr hInstance, voidptr hIcon, ^
 $hCursor_off = voidptr hCursor, $hbrBackground_off = voidptr hbrBackground, ^
 voidptr lpszMenuName, $lpszClassName_off = voidptr lpszClassName }

$wc = /alloc $wc_size
/memset $wc 0 $wc_size

/set $wc+$style_off u32 3
/set $wc+$lpfnWndProc_off voidptr $lpfnWndProc
/set $wc+$hInstance_off voidptr $hInstance
/set $wc+$hCursor_off voidptr $hCursor
/set $wc+$hbrBackground_off voidptr 6
/set $wc+$lpszClassName_off voidptr $lpszClassName

$class_atom = user32.dll u16 RegisterClassW(voidptr $wc) --print-result --assert=nonzero
$hWnd = user32.dll voidptr CreateWindowExW(u32 0, voidptr $lpszClassName, voidptr $lpWindowName, ^
 u32 0x00CF0000, i32 100, i32 100, i32 400, i32 200, voidptr 0, voidptr 0, voidptr $hInstance, voidptr 0) --print-result --assert=nonzero
user32.dll i32 ShowWindow(voidptr $hWnd, i32 5)

$msg = /alloc 48
/memset $msg 0 48
/repeat-until {user32.dll i32 GetMessageW(voidptr $msg, voidptr 0, u32 0, u32 0) --assert=nonzero, ^
 user32.dll i32 TranslateMessage(voidptr $msg), user32.dll i64 DispatchMessageW(voidptr $msg)}

msvcrt.dll i32 wprintf(wstr "goodbye!\n")
/free $wc
/free $msg
/quit
