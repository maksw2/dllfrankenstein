struct WNDCLASSW {
    u32 style,
    ptr lpfnWndProc,
    i32 cbClsExtra,
    i32 cbWndExtra,
    ptr hInstance,
    ptr hIcon,
    ptr hCursor,
    ptr hbrBackground,
    wstr lpszMenuName,
    wstr lpszClassName,
}

struct POINT {
    i32 x,
    i32 y,
}
struct MSG {
    ptr hwnd,
    u32 message,
    u64 wParam,
    i64 lParam,
    u32 time,
    POINT pt,
    u32 lPrivate,
}

i64 WindowProc(ptr $hwnd, u32 $msg, u64 $wparam, i64 $lparam) {
    if ($msg == 2) {
        user32.dll void PostQuitMessage(i32 0)
        return 0
    }
    return user32.dll i64 DefWindowProcW(ptr $hwnd, u32 $msg, u64 $wparam, i64 $lparam)
}

$instance = kernel32.dll ptr GetModuleHandleW(ptr 0)
$cursor = user32.dll ptr LoadCursorW(ptr 0, ptr 32512)
$class_name = wstr "dllfrankenstein-window-w"
$window_name = wstr "dllfrankenstein wide"

$wc = WNDCLASSW {
    .style = 3,
    .lpfnWndProc = &WindowProc,
    .hInstance = $instance,
    .hCursor = $cursor,
    .hbrBackground = ptr 6,
    .lpszClassName = $class_name
}

assert(user32.dll u16 RegisterClassW(ptr &$wc) != 0)
$window = user32.dll ptr CreateWindowExW(
    u32 0, wstr $class_name, wstr $window_name, u32 0x00CF0000,
    i32 100, i32 100, i32 400, i32 200,
    ptr 0, ptr 0, ptr $instance, ptr 0
)
assert($window != 0)
user32.dll i32 ShowWindow(ptr $window, i32 5)

$msg = MSG {}
while (user32.dll i32 GetMessageW(ptr &$msg, ptr 0, u32 0, u32 0) > 0) {
    user32.dll i32 TranslateMessage(ptr &$msg)
    user32.dll i64 DispatchMessageW(ptr &$msg)
}
