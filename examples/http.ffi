$AF_INET = i32 2
$SOCK_STREAM = i32 1
$IPPROTO_TCP = i32 6
$MEM_COMMIT = u32 0x1000
$MEM_RELEASE = u32 0x8000
$PAGE_READWRITE = i32 0x04
$GENERIC_READ = i32 0x80000000
$OPEN_EXISTING = i32 3
$port = u16 8080

$raw_sockaddr_in_size = /struct { $sin_family_off = u16 sin_family, $sin_port_off = u16 sin_port, $sin_addr_off = u32 sin_addr, u64 sin_zero }

$wsa = msvcrt.dll voidptr malloc(u64 4096) --assert=nonzero
$addr = msvcrt.dll voidptr malloc(u64 $raw_sockaddr_in_size) --assert=nonzero
$req_buf = msvcrt.dll voidptr malloc(u64 32768) --assert=nonzero

; --- STRINGS SETUP ---
$delim = str " "

$sec_dot = str ".."
$sec_colon = str ":"
$sec_back = str "\\"

$ext_html = str ".html"
$ext_js   = str ".js"
$ext_css  = str ".css"
$ext_jpg  = str ".jpg"
$ext_jpeg = str ".jpeg"
$ext_png  = str ".png"
$ext_txt  = str ".txt"
$ext_ico  = str ".ico"

$mime_html = str "text/html"
$mime_js   = str "application/javascript"
$mime_css  = str "text/css"
$mime_jpg  = str "image/jpeg"
$mime_jpeg = str "image/jpeg"
$mime_png  = str "image/png"
$mime_txt  = str "text/plain"
$mime_ico  = str "image/x-icon"
$mime_def  = str "application/octet-stream"

/loaddll ws2_32.dll
i32 WSAStartup(u16 0x0202, voidptr $wsa) --assert=zero

$server_socket = u64 socket(i32 $AF_INET, i32 $SOCK_STREAM, i32 $IPPROTO_TCP)

/set $addr + $sin_family_off u16 $AF_INET
$sin_port = u16 htons(u16 $port)
/set $addr + $sin_port_off u16 $sin_port
/set $addr + $sin_addr_off u32 0

i32 bind(u64 $server_socket, voidptr $addr, i32 16) --assert=zero
i32 listen(u64 $server_socket, i32 10) --assert=zero

$head200_buf = msvcrt.dll voidptr malloc(u64 2048) --assert=nonzero
$head404_buf = msvcrt.dll voidptr malloc(u64 2048) --assert=nonzero
$tmp_buf     = msvcrt.dll voidptr malloc(u64 128)  --assert=nonzero

msvcrt.dll i32 printf(str "server started on %hhu\n", u8 $port)

/repeat {
    $client_socket = u64 accept(u64 $server_socket, voidptr 0, voidptr 0)

    $received = i32 recv(u64 $client_socket, voidptr $req_buf, i32 4096, i32 0)
    /set $req_buf + $received u8 0

    $filename_ptr = voidptr $req_buf + 5
    $token = msvcrt.dll voidptr strtok(voidptr $filename_ptr, voidptr $delim)

    $hFile = kernel32.dll voidptr CreateFileA(voidptr $filename_ptr, u32 $GENERIC_READ, u32 0, voidptr 0, u32 $OPEN_EXISTING, u32 0, voidptr 0)

    $ptr_dot = msvcrt.dll voidptr strstr(voidptr $filename_ptr, voidptr $sec_dot)
    $ptr_colon = msvcrt.dll voidptr strstr(voidptr $filename_ptr, voidptr $sec_colon)
    $ptr_back = msvcrt.dll voidptr strstr(voidptr $filename_ptr, voidptr $sec_back)

    $unsafe = u64 $ptr_dot | $ptr_colon
    $unsafe = u64 $unsafe | $ptr_back
    
    ; Set sign bit if non-zero
    $unsafe_i = i64 $unsafe
    $u_neg = i64 -$unsafe_i
    $u_or = i64 $unsafe_i | $u_neg
    ; Shift sign bit to bottom (Result is 1 or -1)
    $u_shift = i64 $u_or >> 63
    ; Expand 1 to -1 (All 1s)
    $u_shift_neg = i64 -$u_shift
    $u_mask = i64 $u_shift | $u_shift_neg
    ; Invert for Safety Mask (0 if unsafe, -1 if safe)
    $safety_mask = i64 ~$u_mask
    ; Normalize to 1 (0 or 1) for arithmetic
    $safety_bool = i64 $safety_mask & 1

    ; Check if file exists
    $tmp = u64 $hFile ^ 0xFFFFFFFFFFFFFFFF
    $neg = i64 -$tmp
    $or = u64 $tmp | $neg
    $or_i = i64 $or
    $tmp2 = i64 $or_i >> 63
    ; Robust expansion not strictly needed for & 1, but safe:
    $tmp2_neg = i64 -$tmp2
    $exists_mask_full = i64 $tmp2 | $tmp2_neg
    $file_exists_bool = i64 $exists_mask_full & 1
    
    ; Combine Bools (0 or 1)
    $mask_bool = i64 $file_exists_bool & $safety_bool
    $inv_mask_bool = i64 1 - $mask_bool

    ; Find extension
    $dot_ptr = msvcrt.dll voidptr strrchr(voidptr $filename_ptr, i32 46)

    ; Handle NULL dot_ptr
    $d_val = i64 $dot_ptr
    $d_neg = i64 -$d_val
    $d_or  = i64 $d_val | $d_neg
    $d_shift = i64 $d_or >> 63

    ; Expand to Full Mask (-1)
    $d_shift_neg = i64 -$d_shift
    $dot_exists_mask = i64 $d_shift | $d_shift_neg
    $inv_dot_exists_mask = i64 ~$dot_exists_mask

    ; Select Safe Dot String
    $safe_dot = u64 $dot_ptr & $dot_exists_mask
    $fallback_ptr = u64 $delim & $inv_dot_exists_mask
    $safe_dot = u64 $safe_dot | $fallback_ptr

    ; Compare and Build Masks
    ; We want -1 if Match (0), 0 if Diff.
    
    ; HTML
    $d_html = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_html)
    $d_html_i = i64 $d_html
    $neg_html = i64 -$d_html_i
    $dh_or  = i64 $d_html_i | $neg_html
    $dh_shift = i64 $dh_or >> 63
    ; Expand 1 -> -1 (This gives -1 if Diff, 0 if Match)
    $dh_neg = i64 -$dh_shift
    $dh_diff_mask = i64 $dh_shift | $dh_neg
    ; Invert (This gives 0 if Diff, -1 if Match)
    $m_html = i64 ~$dh_diff_mask
    
    ; JS
    $d_js   = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_js)
    $d_js_i = i64 $d_js
    $neg_js = i64 -$d_js_i
    $dj_or  = i64 $d_js_i | $neg_js
    $dj_shift = i64 $dj_or >> 63
    $dj_neg = i64 -$dj_shift
    $dj_diff_mask = i64 $dj_shift | $dj_neg
    $m_js   = i64 ~$dj_diff_mask

    ; CSS
    $d_css  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_css)
    $d_css_i = i64 $d_css
    $neg_css = i64 -$d_css_i
    $dc_or  = i64 $d_css_i | $neg_css
    $dc_shift = i64 $dc_or >> 63
    $dc_neg = i64 -$dc_shift
    $dc_diff_mask = i64 $dc_shift | $dc_neg
    $m_css  = i64 ~$dc_diff_mask

    ; JPG
    $d_jpg  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_jpg)
    $d_jpg_i = i64 $d_jpg
    $neg_jpg = i64 -$d_jpg_i
    $djg_or  = i64 $d_jpg_i | $neg_jpg
    $djg_shift = i64 $djg_or >> 63
    $djg_neg = i64 -$djg_shift
    $djg_diff_mask = i64 $djg_shift | $djg_neg
    $m_jpg  = i64 ~$djg_diff_mask

    ; JPEG
    $d_jpeg  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_jpeg)
    $d_jpeg_i = i64 $d_jpeg
    $neg_jpeg = i64 -$d_jpeg_i
    $dje_or  = i64 $d_jpeg_i | $neg_jpeg
    $dje_shift = i64 $dje_or >> 63
    $dje_neg = i64 -$dje_shift
    $dje_diff_mask = i64 $dje_shift | $dje_neg
    $m_jpeg  = i64 ~$dje_diff_mask
    
    ; PNG
    $d_png  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_png)
    $d_png_i = i64 $d_png
    $neg_png = i64 -$d_png_i
    $dp_or  = i64 $d_png_i | $neg_png
    $dp_shift = i64 $dp_or >> 63
    $dp_neg = i64 -$dp_shift
    $dp_diff_mask = i64 $dp_shift | $dp_neg
    $m_png  = i64 ~$dp_diff_mask

    ; TXT
    $d_txt  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_txt)
    $d_txt_i = i64 $d_txt
    $neg_txt = i64 -$d_txt_i
    $dt_or  = i64 $d_txt_i | $neg_txt
    $dt_shift = i64 $dt_or >> 63
    $dt_neg = i64 -$dt_shift
    $dt_diff_mask = i64 $dt_shift | $dt_neg
    $m_txt  = i64 ~$dt_diff_mask

    ; ICO
    $d_ico  = msvcrt.dll i32 _stricmp(voidptr $safe_dot, voidptr $ext_ico)
    $d_ico_i = i64 $d_ico
    $neg_ico = i64 -$d_ico_i
    $di_or  = i64 $d_ico_i | $neg_ico
    $di_shift = i64 $di_or >> 63
    $di_neg = i64 -$di_shift
    $di_diff_mask = i64 $di_shift | $di_neg
    $m_ico  = i64 ~$di_diff_mask

    ; Calculate Default Mask
    $any_match = i64 $m_html | $m_js
    $any_match = i64 $any_match | $m_css
    $any_match = i64 $any_match | $m_jpg
    $any_match = i64 $any_match | $m_jpeg
    $any_match = i64 $any_match | $m_png
    $any_match = i64 $any_match | $m_txt
    $any_match = i64 $any_match | $m_ico
    $m_def     = i64 ~$any_match

    ; Select String (Bitwise Multiplexer)
    $tmp_ptr  = u64 $mime_html & $m_html
    $sel_mime = u64 $tmp_ptr

    $tmp_ptr  = u64 $mime_js & $m_js
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_css & $m_css
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_jpg & $m_jpg
    $sel_mime = u64 $sel_mime | $tmp_ptr
    
    $tmp_ptr  = u64 $mime_jpg & $m_jpeg
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_png & $m_png
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_txt & $m_txt
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_ico & $m_ico
    $sel_mime = u64 $sel_mime | $tmp_ptr

    $tmp_ptr  = u64 $mime_def & $m_def
    $sel_mime = u64 $sel_mime | $tmp_ptr

    msvcrt.dll i32 printf(str "req file: %s, req mime: %s\n", voidptr $filename_ptr, voidptr $sel_mime)

    msvcrt.dll i32 sprintf(voidptr $head404_buf, str "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 0\r\n\r\n")
    $len404 = msvcrt.dll i32 sprintf(voidptr $tmp_buf, str "%s", voidptr $head404_buf)

    $fileSize = kernel32.dll u32 GetFileSize(voidptr $hFile, voidptr 0)
    $mask_u32 = u32 $mask_bool
    $fileSize_masked = u32 $fileSize * $mask_u32

    $header_len = msvcrt.dll i32 sprintf(voidptr $head200_buf, str "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nContent-Length: %d\r\n\r\n", voidptr $sel_mime, u32 $fileSize_masked)

    $send_len200 = i32 $header_len * $mask_u32
    $send_len404 = i32 $len404 * $inv_mask_bool

    i32 send(u64 $client_socket, voidptr $head200_buf, i32 $send_len200, i32 0)
    i32 send(u64 $client_socket, voidptr $head404_buf, i32 $send_len404, i32 0)

    $fileMem = kernel32.dll voidptr VirtualAlloc(voidptr 0, u64 $fileSize_masked, u32 $MEM_COMMIT, u32 $PAGE_READWRITE)
    $bytesRead = u32 0
    kernel32.dll i32 ReadFile(voidptr $hFile, voidptr $fileMem, u32 $fileSize_masked, voidptr &$bytesRead, voidptr 0)
    i32 send(u64 $client_socket, voidptr $fileMem, i32 $fileSize_masked, i32 0)

    kernel32.dll i32 CloseHandle(voidptr $hFile)
    kernel32.dll i32 VirtualFree(voidptr $fileMem, u64 0, u32 $MEM_RELEASE)
    i32 closesocket(u64 $client_socket)
}

msvcrt.dll void free(voidptr $wsa)
msvcrt.dll void free(voidptr $addr)
msvcrt.dll void free(voidptr $req_buf)
msvcrt.dll void free(voidptr $head200_buf)
msvcrt.dll void free(voidptr $head404_buf)
msvcrt.dll void free(voidptr $tmp_buf)
msvcrt.dll void free(voidptr $delim)

msvcrt.dll i32 printf(str "goodbye!\n")
/quit