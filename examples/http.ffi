; http.ffi
; Tiny single-threaded static file server. Run from examples/ and open localhost:8080.

struct SOCKADDR_IN {
    u16 sin_family,
    u16 sin_port,
    u32 sin_addr,
    u8 sin_zero[8],
}

$AF_INET       = i32 2
$SOCK_STREAM   = i32 1
$IPPROTO_TCP   = i32 6
$GENERIC_READ  = u32 0x80000000
$OPEN_EXISTING = u32 3
$MEM_COMMIT    = u32 0x1000
$MEM_RESERVE   = u32 0x2000
$MEM_RELEASE   = u32 0x8000
$PAGE_READWRITE = u32 0x04
$port = u16 8080

$wsa = msvcrt.dll ptr malloc(u64 4096)
$req_buf = msvcrt.dll ptr malloc(u64 32768)
$head_buf = msvcrt.dll ptr malloc(u64 2048)
assert($wsa != 0 && $req_buf != 0 && $head_buf != 0, "server buffers")

assert(ws2_32.dll i32 WSAStartup(u16 0x0202, ptr $wsa) == 0, "WSAStartup")
$server_socket = ws2_32.dll u64 socket(i32 $AF_INET, i32 $SOCK_STREAM, i32 $IPPROTO_TCP)
assert($server_socket != 0xFFFFFFFFFFFFFFFF, "socket")

$addr = SOCKADDR_IN {
    .sin_family = u16 $AF_INET,
    .sin_port = ws2_32.dll u16 htons(u16 $port),
    .sin_addr = 0
}

assert(ws2_32.dll i32 bind(u64 $server_socket, ptr &$addr, i32 sizeof(SOCKADDR_IN)) == 0, "bind")
assert(ws2_32.dll i32 listen(u64 $server_socket, i32 10) == 0, "listen")
msvcrt.dll i32 printf(str "server started on http://localhost:%hu\n", u16 $port)

$mime_html = str "text/html"
$mime_js   = str "application/javascript"
$mime_css  = str "text/css"
$mime_jpg  = str "image/jpeg"
$mime_png  = str "image/png"
$mime_txt  = str "text/plain"
$mime_ico  = str "image/x-icon"
$mime_def  = str "application/octet-stream"

while (1) {
    $client_socket = ws2_32.dll u64 accept(u64 $server_socket, ptr 0, ptr 0)
    if ($client_socket == 0xFFFFFFFFFFFFFFFF) {
        continue
    }

    $received = ws2_32.dll i32 recv(u64 $client_socket, ptr $req_buf, i32 32767, i32 0)
    if ($received <= 0) {
        ws2_32.dll i32 closesocket(u64 $client_socket)
        continue
    }

    u8 *($req_buf + $received) = 0

    ; Request starts with "GET /". strtok terminates the path at the following space.
    $filename = $req_buf + 5
    msvcrt.dll ptr strtok(ptr $filename, str " ")

    $unsafe_parent = msvcrt.dll ptr strstr(ptr $filename, str "..")
    $unsafe_colon  = msvcrt.dll ptr strstr(ptr $filename, str ":")
    $unsafe_slash  = msvcrt.dll ptr strstr(ptr $filename, str "\\")
    if ($unsafe_parent != 0 || $unsafe_colon != 0 || $unsafe_slash != 0) {
        $header_len = msvcrt.dll i32 sprintf(ptr $head_buf, str "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        ws2_32.dll i32 send(u64 $client_socket, ptr $head_buf, i32 $header_len, i32 0)
        ws2_32.dll i32 closesocket(u64 $client_socket)
        continue
    }

    ; A bare / serves index.html.
    if (msvcrt.dll i32 strcmp(ptr $filename, str "") == 0) {
        $filename = ptr "index.html"
    }

    $file = kernel32.dll ptr CreateFileA(ptr $filename, u32 $GENERIC_READ, u32 1, ptr 0, u32 $OPEN_EXISTING, u32 0, ptr 0)
    if ($file == 0xFFFFFFFFFFFFFFFF) {
        $header_len = msvcrt.dll i32 sprintf(ptr $head_buf, str "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        ws2_32.dll i32 send(u64 $client_socket, ptr $head_buf, i32 $header_len, i32 0)
        ws2_32.dll i32 closesocket(u64 $client_socket)
        continue
    }

    $mime = $mime_def
    $ext = msvcrt.dll ptr strrchr(ptr $filename, i32 46)
    if ($ext != 0) {
        if (msvcrt.dll i32 _stricmp(ptr $ext, str ".html") == 0) {
            $mime = $mime_html
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".htm") == 0) {
            $mime = $mime_html
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".js") == 0) {
            $mime = $mime_js
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".css") == 0) {
            $mime = $mime_css
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".jpg") == 0) {
            $mime = $mime_jpg
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".jpeg") == 0) {
            $mime = $mime_jpg
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".png") == 0) {
            $mime = $mime_png
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".txt") == 0) {
            $mime = $mime_txt
        } else if (msvcrt.dll i32 _stricmp(ptr $ext, str ".ico") == 0) {
            $mime = $mime_ico
        }
    }

    $file_size = kernel32.dll u32 GetFileSize(ptr $file, ptr 0)
    $header_len = msvcrt.dll i32 sprintf(
        ptr $head_buf,
        str "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nContent-Length: %u\r\nConnection: close\r\n\r\n",
        str $mime,
        u32 $file_size
    )
    ws2_32.dll i32 send(u64 $client_socket, ptr $head_buf, i32 $header_len, i32 0)

    if ($file_size != 0) {
        $file_mem = kernel32.dll ptr VirtualAlloc(ptr 0, u64 $file_size, u32 $MEM_COMMIT | $MEM_RESERVE, u32 $PAGE_READWRITE)
        assert($file_mem != 0, "VirtualAlloc file")
        $bytes_read = u32 0
        assert(kernel32.dll i32 ReadFile(ptr $file, ptr $file_mem, u32 $file_size, ptr &$bytes_read, ptr 0) != 0, "ReadFile")
        ws2_32.dll i32 send(u64 $client_socket, ptr $file_mem, i32 $bytes_read, i32 0)
        kernel32.dll i32 VirtualFree(ptr $file_mem, u64 0, u32 $MEM_RELEASE)
    }

    msvcrt.dll i32 printf(str "200 %s (%u bytes, %s)\n", ptr $filename, u32 $file_size, str $mime)
    kernel32.dll i32 CloseHandle(ptr $file)
    ws2_32.dll i32 closesocket(u64 $client_socket)
}
