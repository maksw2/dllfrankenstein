; gl.ffi
; OpenGL 1.1 demonstration using GLFW

assert(glfw3.dll i32 glfwInit() != 0, "glfwInit")
$window = glfw3.dll ptr glfwCreateWindow(i32 640, i32 480, str "Triangle", ptr 0, ptr 0)
assert($window != 0, "glfwCreateWindow")
glfw3.dll void glfwMakeContextCurrent(ptr $window)

while (glfw3.dll i32 glfwWindowShouldClose(ptr $window) == 0) {
    opengl32.dll void glClear(u32 0x4000)
    opengl32.dll void glColor3f(f32 1.0, f32 0.0, f32 0.0)
    opengl32.dll void glBegin(u32 0x0004)
    opengl32.dll void glVertex2f(f32 -0.5, f32 -0.5)
    opengl32.dll void glVertex2f(f32 0.5, f32 -0.5)
    opengl32.dll void glVertex2f(f32 0.0, f32 0.5)
    opengl32.dll void glEnd()
    opengl32.dll void glFlush()
    glfw3.dll void glfwSwapBuffers(ptr $window)
    glfw3.dll void glfwPollEvents()
}

glfw3.dll void glfwDestroyWindow(ptr $window)
glfw3.dll void glfwTerminate()
msvcrt.dll i32 printf(str "goodbye!\n")
