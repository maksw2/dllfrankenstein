struct WNDCLASSA {
    u32 style,
    ptr lpfnWndProc,
    i32 cbClsExtra,
    i32 cbWndExtra,
    ptr hInstance,
    ptr hIcon,
    ptr hCursor,
    ptr hbrBackground,
    ptr lpszMenuName,
    str lpszClassName,
}

struct POINT {
    i32 x,
    i32 y,
}

struct MSG {
    ptr hwnd,
    u32 message,
    u64 wParam,
    i64 lParam,
    u32 time,
    POINT pt,
    u32 lPrivate,
}

i64 WindowProc(ptr $hwnd, u32 $msg, u64 $wparam, i64 $lparam) {
    if ($msg == 2) {
        user32.dll void PostQuitMessage(i32 0)
        return 0
    }

    if ($msg == 20) {
        return 1
    }

    return user32.dll i64 DefWindowProcA(ptr $hwnd, u32 $msg, u64 $wparam, i64 $lparam)
}

$instance = kernel32.dll ptr GetModuleHandleA(ptr 0)
assert($instance != 0, "GetModuleHandleA")
$cursor = user32.dll ptr LoadCursorA(ptr 0, i64 32512)
$class_name = str "dllfrankenstein-window"
$window_name = str "dllfrankenstein"

$wc = WNDCLASSA {
    .style = 3,
    .lpfnWndProc = &WindowProc,
    .hInstance = $instance,
    .hCursor = $cursor,
    .hbrBackground = ptr 6,
    .lpszClassName = $class_name
}

$atom = user32.dll u16 RegisterClassA(ptr &$wc)
assert($atom != 0, "RegisterClassA")

$window = user32.dll ptr CreateWindowExA(
    u32 0,
    str $class_name,
    str $window_name,
    u32 0x00CF0000,
    i32 100,
    i32 100,
    i32 400,
    i32 200,
    ptr 0,
    ptr 0,
    ptr $instance,
    ptr 0
)
assert($window != 0, "CreateWindowExA")
user32.dll i32 ShowWindow(ptr $window, i32 5)

$msg = MSG {}
while (user32.dll i32 GetMessageA(ptr &$msg, ptr 0, u32 0, u32 0) > 0) {
    user32.dll i32 TranslateMessage(ptr &$msg)
    user32.dll i64 DispatchMessageA(ptr &$msg)
}

msvcrt.dll i32 printf(str "goodbye!\n")
